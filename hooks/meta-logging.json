{
  "_comment": "cheat-on-x meta-logging hook. Passively records event metadata to .cheatx-cache/usage.jsonl (event type, tool, file, prompt presence/length — never prompt text). Background, never blocks.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/.cheatx-hooks/log-event.sh\" tool_use &", "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/.cheatx-hooks/log-event.sh\" user_prompt &", "timeout": 5 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/.cheatx-hooks/log-event.sh\" session_start &", "timeout": 5 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/.cheatx-hooks/log-event.sh\" session_end &", "timeout": 5 }
        ]
      }
    ]
  }
}
